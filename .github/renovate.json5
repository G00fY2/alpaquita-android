{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:best-practices',
        ':semanticCommits',
        ':semanticCommitTypeAll(ci)',
        ':semanticCommitScope(deps)',
        ':disableRateLimiting',
        ':automergeAll',
    ],
    customManagers: [
        {
            customType: 'regex',
            managerFilePatterns: [
                '.github/workflows/*.yaml',
            ],
            matchStrings: [
                'DOCKER_BUILDX_VERSION:\\s*(?<currentValue>.*)',
            ],
            depNameTemplate: 'docker/buildx',
            datasourceTemplate: 'github-releases',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '.github/workflows/*.yaml',
            ],
            matchStrings: [
                'DOCKER_BUILDKIT_VERSION:\\s*(?<currentValue>.*)',
            ],
            depNameTemplate: 'moby/buildkit',
            datasourceTemplate: 'github-releases',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '.github/workflows/*.yaml',
            ],
            matchStrings: [
                'DIVE_VERSION:\\s*(?<currentValue>.*)',
            ],
            depNameTemplate: 'wagoodman/dive',
            datasourceTemplate: 'github-releases',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '.github/workflows/*.yaml',
            ],
            matchStrings: [
                'ACTIONLINT_VERSION:\\s*(?<currentValue>.*)',
            ],
            depNameTemplate: 'rhysd/actionlint',
            datasourceTemplate: 'github-releases',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '.github/workflows/*.yaml',
            ],
            matchStrings: [
                'YAMLLINT_VERSION:\\s*(?<currentValue>.*)',
            ],
            depNameTemplate: 'yamllint',
            datasourceTemplate: 'pypi',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '/versions\\.env$/',
            ],
            matchStrings: [
                'ANDROID_CLI_VERSION=(?<currentValue>.*)',
            ],
            depNameTemplate: 'android-cli',
            datasourceTemplate: 'deb',
            registryUrlTemplate: 'https://dl.google.com/android/cli/latest/debian?suite=stable&components=main&binaryArch=amd64',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '/versions\\.env$/',
            ],
            matchStrings: [
                'ANDROID_CMDLINE_TOOLS_VERSION=(?<currentValue>.*)',
            ],
            depNameTemplate: 'android_cmdline_tools',
            datasourceTemplate: 'custom.android_cmdline_tools',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '/versions\\.env$/',
            ],
            matchStrings: [
                'ANDROID_PLATFORM_TOOLS_VERSION=(?<currentValue>.*)',
            ],
            depNameTemplate: 'android_platform_tools',
            datasourceTemplate: 'custom.android_platform_tools',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '/versions\\.env$/',
            ],
            matchStrings: [
                'ANDROID_BUILD_TOOLS_VERSION=(?<currentValue>.*)',
            ],
            depNameTemplate: 'android_build_tools',
            datasourceTemplate: 'custom.android_build_tools',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '/versions\\.env$/',
            ],
            matchStrings: [
                'ANDROID_PLATFORM_MAX_VERSION=(?<currentValue>.*)',
            ],
            depNameTemplate: 'android_platform_version',
            datasourceTemplate: 'custom.android_platform_version',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '/versions\\.env$/',
            ],
            matchStrings: [
                'ANDROID_IMAGE_GOOGLE_APIS_VERSION=(?<currentValue>.*)',
            ],
            depNameTemplate: 'android_atd_system_version',
            datasourceTemplate: 'custom.android_atd_system_version',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '/versions\\.env$/',
            ],
            matchStrings: [
                'ANDROID_EMULATOR_VERSION=(?<currentValue>.*)',
            ],
            depNameTemplate: 'android_emulator',
            datasourceTemplate: 'custom.android_emulator_version',
        },
    ],
    customDatasources: {
        android_cmdline_tools: {
            defaultRegistryUrlTemplate: 'https://dl.google.com/android/repository/repository2-1.xml',
            format: 'plain',
            transformTemplates: [
                'releases[$contains(version, "cmdline-tools;")].version',
                '$map($, function($v) { $replace($v, /.*cmdline-tools;([^"]+).*/, "$1") })',
                '{"releases": [ $map($, function($v) { {"version": $v} }) ]}',
            ],
        },
        android_platform_tools: {
            defaultRegistryUrlTemplate: 'https://dl.google.com/android/repository/repository2-1.xml',
            format: 'plain',
            transformTemplates: [
                'releases[($contains(version, "platform-tools_r") and $contains(version, "-linux.zip"))].version',
                '$map($, function($v) { $replace($v, /.*platform-tools_r([^-]+)-linux.*/, "$1") })',
                '{"releases": [ $map($, function($v) { {"version": $v} }) ]}',
            ],
        },
        android_build_tools: {
            defaultRegistryUrlTemplate: 'https://dl.google.com/android/repository/repository2-1.xml',
            format: 'plain',
            transformTemplates: [
                'releases[$contains(version, "build-tools;")].version',
                '$map($, function($v) { $replace($v, /.*build-tools;([^"]+).*/, "$1") })',
                '{"releases": [ $map($, function($v) { {"version": $v} }) ]}',
            ],
        },
        android_platform_version: {
            defaultRegistryUrlTemplate: 'https://dl.google.com/android/repository/repository2-3.xml',
            format: 'plain',
            transformTemplates: [
                'releases[($contains(version, "platforms;android-") or $contains(version, "<major>"))].version',
                '$map($, function($v) { $replace($v, /.*platforms;android-([^"]+).*/, "v:$1") })',
                '$map($, function($v) { $replace($v, /.*<major>([0-9]+)<.*/, "r:$1") })',
                '$map($, function($v, $i) { $contains($v, /^v:/) ? $replace($v, "v:", "") & "-rev" & ($contains($[$i+1], /^r:/) ? $replace($[$i+1], "r:", "") : "0") : null })',
                '$filter($, function($v) { $v != null })',
                '{"releases": [ $map($, function($v) { {"version": $v} }) ]}',
            ],
        },
        android_emulator_version: {
            defaultRegistryUrlTemplate: 'https://dl.google.com/android/repository/repository2-3.xml',
            format: 'plain',
            transformTemplates: [
                'releases.version',
                '$split($join($, " "), "<remotePackage path=")',
                '$filter($, function($b) { $contains($b, /^"emulator"/) and $contains($b, /channelRef ref="channel-0"/) })',
                '$map($, function($b) { ( $rev := $substringBefore($substringAfter($b, "<revision>"), "</revision>"); $part := function($tag) { $substringBefore($substringAfter($rev, "<" & $tag & ">"), "</" & $tag & ">") }; $part("major") & "." & $part("minor") & "." & $part("micro") ) })',
                '{"releases": [ $map($, function($v) { {"version": $v} }) ]}',
            ],
        },
        android_atd_system_version: {
            defaultRegistryUrlTemplate: 'https://dl.google.com/android/repository/sys-img/google_atd/sys-img2-3.xml',
            format: 'plain',
            transformTemplates: [
                'releases.version',
                '$split($join($, " "), "<remotePackage path=")',
                '$filter($, function($b) { $contains($b, /^"system-images;android-[^;]+;google_atd;x86_64"/) and $contains($b, /channelRef ref="channel-0"/) })',
                '$map($, function($b) { $substringBefore($substringAfter($b, "android-"), ";") & "-rev" & $substringBefore($substringAfter($substringAfter($b, "<revision>"), "<major>"), "</major>") })',
                '{"releases": [ $map($, function($v) { {"version": $v} }) ]}',
            ],
        }
    },
    packageRules: [
        {
            description: 'Group Android SDK updates',
            matchPackageNames: [
                'android-cli',
                'android_cmdline_tools',
                'android_platform_tools',
                'android_build_tools',
                'android_platform_version',
            ],
            matchFileNames: [
                'android/versions.env',
            ],
            groupName: 'android sdk components',
            versioning: 'regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?(-rev(?<build>\\d+))?$',
        },
        {
            description: 'Use "feat" for major/minor Android SDK updates',
            matchPackageNames: [
                'android-cli',
                'android_cmdline_tools',
                'android_platform_tools',
                'android_build_tools',
                'android_platform_version',
            ],
            matchFileNames: [
                'android/versions.env',
            ],
            groupName: 'android sdk components',
            matchUpdateTypes: [
                'major',
                'minor',
            ],
            semanticCommitType: 'feat',
            semanticCommitScope: 'sdk',
        },
        {
            description: 'Use "fix" for patch Android SDK updates',
            matchPackageNames: [
                'android-cli',
                'android_cmdline_tools',
                'android_platform_tools',
                'android_build_tools',
                'android_platform_version',
            ],
            matchFileNames: [
                'android/versions.env',
            ],
            groupName: 'android sdk components',
            matchUpdateTypes: [
                'patch',
            ],
            semanticCommitType: 'fix',
            semanticCommitScope: 'sdk',
        },
        {
            description: 'Group Android Emulator updates',
            matchPackageNames: [
                'android_emulator',
                'android_atd_system_version',
                'android_platform_tools',
            ],
            matchFileNames: [
                'emulator/versions.env',
            ],
            groupName: 'android emulator components',
            versioning: 'regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?(-rev(?<build>\\d+))?$',
        },
        {
            description: 'Use "feat" for major/minor Android Emulator updates',
            matchPackageNames: [
                'android_emulator',
                'android_atd_system_version',
                'android_platform_tools',
            ],
            matchFileNames: [
                'emulator/versions.env',
            ],
            groupName: 'android emulator components',
            matchUpdateTypes: [
                'major',
                'minor',
            ],
            semanticCommitType: 'feat',
            semanticCommitScope: 'emulator',
        },
        {
            description: 'Use "fix" for patch Android Emulator updates',
            matchPackageNames: [
                'android_emulator',
                'android_atd_system_version',
                'android_platform_tools',
            ],
            matchFileNames: [
                'emulator/versions.env',
            ],
            groupName: 'android emulator components',
            matchUpdateTypes: [
                'patch',
            ],
            semanticCommitType: 'fix',
            semanticCommitScope: 'emulator',
        },
        {
            description: 'Group Liberica JDK images updates (fix)',
            matchPackageNames: [
                'ghcr.io/bell-sw/liberica-runtime-container',
            ],
            versioning: 'regex:^jdk-(?<major>\\d+)?(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))?([\\._+](?<build>(\\d\\.?)+))?(-(?<compatibility>.*))?$',
            major: {
                enabled: false,
            },
            groupName: 'liberica jdk container',
            /* Bi-weekly Batching after Tuesday releases (relative to timezone below):
               Minute: * (Every minute)
               Hour:   4-23 (04:00 AM - 11:59 PM - Catch-all after Tuesday releases)
               Days:   1-7, 15-21 (1st and 3rd week of month)
               Month:  * (Every month)
               DayWk:  3 (Wednesday)
            */
            schedule: [
                '* 4-23 1-7,15-21 * 3',
            ],
            timezone: 'America/Los_Angeles',
            semanticCommitType: 'fix',
            semanticCommitScope: 'sdk',
        },
        {
            description: 'Use "fix" for Base Alpaquita updates',
            matchPackageNames: [
                'ghcr.io/bell-sw/alpaquita-linux-base',
            ],
            groupName: 'alpaquita base container',
            /* Bi-weekly Batching after Tuesday releases (relative to timezone below):
               Minute: * (Every minute)
               Hour:   4-23 (04:00 AM - 11:59 PM - Catch-all after Tuesday releases)
               Days:   1-7, 15-21 (1st and 3rd week of month)
               Month:  * (Every month)
               DayWk:  3 (Wednesday)
            */
            schedule: [
                '* 4-23 1-7,15-21 * 3',
            ],
            timezone: 'America/Los_Angeles',
            semanticCommitType: 'fix',
            semanticCommitScope: 'emulator',
        },
        {
            description: 'Group official Docker Build Tool and Actions',
            matchPackageNames: [
                'docker/**',
                'moby/**',
            ],
            groupName: 'docker build tools and actions',
            separateMajorMinor: false,
            // Every Sunday (all day)
            schedule: [
                '* * * * 0',
            ],
        },
        {
            description: 'Group official GitHub Actions',
            matchPackageNames: [
                'actions/**',
            ],
            groupName: 'github core actions',
            separateMajorMinor: false,
            // Every Sunday (all day)
            schedule: [
                '* * * * 0',
            ],
        },
    ],
}
